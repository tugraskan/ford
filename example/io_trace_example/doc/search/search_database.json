var tipuesearch = {"pages":[{"title":" I/O Trace Example ","text":"I/O Trace Example I/O Trace Example Documentation This example demonstrates comprehensive documentation of file I/O operations in Fortran code. Files Documented The example covers four files: aquifer.aqu - Aquifer hydraulic properties (input) object.cnt - Spatial object counts (input) mgt.out - Management operations log (output) aquifer.out - Aquifer water balance (output) Key Features Filename Resolution : Demonstrates how filenames are defined and potentially overridden Unit Mappings : Shows explicit unit-to-file associations Read/Write Payloads : Complete variable definitions for all I/O operations Derived Types : Full expansion of user-defined types with component documentation Documentation Approach See IO_TRACE_DOCUMENTATION.md for the complete I/O trace analysis, which includes: Filename resolution chains I/O site locations with line numbers Variable definitions with types, defaults, units, and descriptions Worked example with detailed walkthrough This example serves as a template for documenting I/O operations in scientific computing applications. Developer Info Example Author This example demonstrates best practices for documenting file I/O operations in Fortran","tags":"home","url":"index.html"},{"title":"object_count_type – I/O Trace Example ","text":"type, public :: object_count_type Derived type for object counts in the simulation domain Components Type Visibility Attributes Name Initial integer, public :: subbasins = 0 integer, public :: hrus = 0 integer, public :: aquifers = 0 integer, public :: channels = 0 integer, public :: reservoirs = 0 integer, public :: point_sources = 0 Source Code type :: object_count_type integer :: subbasins = 0 !< Number of subbasins integer :: hrus = 0 !< Number of hydrologic response units integer :: aquifers = 0 !< Number of aquifers integer :: channels = 0 !< Number of stream channels integer :: reservoirs = 0 !< Number of reservoirs integer :: point_sources = 0 !< Number of point source inputs end type object_count_type","tags":"","url":"type/object_count_type.html"},{"title":"input_files_type – I/O Trace Example ","text":"type, public :: input_files_type Derived type containing all input filenames Components Type Visibility Attributes Name Initial character(len=25), public :: aqu = \"aquifer.aqu\" character(len=25), public :: obj = \"object.cnt\" Source Code type :: input_files_type character ( len = 25 ) :: aqu = \"aquifer.aqu\" !< Aquifer input file (hydraulic properties, initial conditions) character ( len = 25 ) :: obj = \"object.cnt\" !< Object count file (number of spatial objects in simulation) end type input_files_type","tags":"","url":"type/input_files_type.html"},{"title":"aquifer_db_type – I/O Trace Example ","text":"type, public :: aquifer_db_type Aquifer hydraulic properties and state variables\nThis type stores all parameters for a single aquifer Components Type Visibility Attributes Name Initial character(len=16), public :: name = \"\" real, public :: area = 0.0 real, public :: hydraulic_cond = 0.0 real, public :: specific_yield = 0.0 real, public :: alpha = 0.0 real, public :: initial_storage = 0.0 real, public :: min_storage = 0.0 real, public :: max_storage = 0.0 Source Code type :: aquifer_db_type character ( len = 16 ) :: name = \"\" !< Aquifer name/ID real :: area = 0.0 !< Surface area [ha] real :: hydraulic_cond = 0.0 !< Hydraulic conductivity [m/day] real :: specific_yield = 0.0 !< Specific yield (dimensionless, 0-1) real :: alpha = 0.0 !< Baseflow recession coefficient [1/day] real :: initial_storage = 0.0 !< Initial water storage [m&#94;3] real :: min_storage = 0.0 !< Minimum storage threshold [m&#94;3] real :: max_storage = 0.0 !< Maximum storage capacity [m&#94;3] end type aquifer_db_type","tags":"","url":"type/aquifer_db_type.html"},{"title":"output_files_type – I/O Trace Example ","text":"type, public :: output_files_type Output file names Components Type Visibility Attributes Name Initial character(len=25), public :: mgt = \"mgt.out\" character(len=25), public :: aquifer = \"aquifer.out\" Source Code type :: output_files_type character ( len = 25 ) :: mgt = \"mgt.out\" !< Management operations output character ( len = 25 ) :: aquifer = \"aquifer.out\" !< Aquifer water balance output end type output_files_type","tags":"","url":"type/output_files_type.html"},{"title":"mgt_operation_type – I/O Trace Example ","text":"type, public :: mgt_operation_type Management operation data for output Components Type Visibility Attributes Name Initial integer, public :: year = 0 integer, public :: day = 0 integer, public :: hru_id = 0 character(len=16), public :: op_type = \"\" real, public :: amount = 0.0 Source Code type :: mgt_operation_type integer :: year = 0 !< Simulation year integer :: day = 0 !< Day of year integer :: hru_id = 0 !< HRU identifier character ( len = 16 ) :: op_type = \"\" !< Operation type (e.g., \"PLANT\", \"HARVEST\", \"IRRIGATE\") real :: amount = 0.0 !< Operation amount (units vary by operation) end type mgt_operation_type","tags":"","url":"type/mgt_operation_type.html"},{"title":"object_cnt_read – I/O Trace Example","text":"public  subroutine object_cnt_read() Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments n/a Uses n/a Outside Variables and Types n/a Local Variables Type Visibility Attributes Name Initial integer, private :: ios I/O I/O files used in this subroutine. Unit Type Filename Operations unit=108 Unknown in_obj%obj → \"object.cnt\" 1 operation(s) Control Flow Complexity Indicators: Simple Depth: 1 Early Exits: 1 Features: ERROR FILE I/O IF Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. OPEN 5 open(unit=108, file=in_obj%obj, status='old', action='read', iostat=ios) IF ( ios /= 0 ) THEN Lines 7-10 PRINT 8 print *, \"Error opening\", trim(in_obj%obj) RETURN 9 return END IF Line 10 READ 13 read(108, *) READ 16 read(108, *) obj_cnt%subbasins READ 17 read(108, *) obj_cnt%hrus READ 18 read(108, *) obj_cnt%aquifers READ 19 read(108, *) obj_cnt%channels READ 20 read(108, *) obj_cnt%reservoirs READ 21 read(108, *) obj_cnt%point_sources CLOSE 24 close(108) Allocations n/a Source Code subroutine object_cnt_read integer :: ios !< I/O status code ! Open object count file on unit 108 open ( unit = 108 , file = in_obj % obj , status = 'old' , action = 'read' , iostat = ios ) if ( ios /= 0 ) then print * , \"Error opening\" , trim ( in_obj % obj ) return end if ! Read header read ( 108 , * ) ! Read object counts - each on a separate line with label read ( 108 , * ) obj_cnt % subbasins read ( 108 , * ) obj_cnt % hrus read ( 108 , * ) obj_cnt % aquifers read ( 108 , * ) obj_cnt % channels read ( 108 , * ) obj_cnt % reservoirs read ( 108 , * ) obj_cnt % point_sources ! Close file close ( 108 ) end subroutine object_cnt_read","tags":"","url":"proc/object_cnt_read.html"},{"title":"init_input_files – I/O Trace Example","text":"public  subroutine init_input_files(config_file) Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments Type Intent Optional Attributes Name character(len=*), intent(in), optional :: config_file Uses n/a Outside Variables and Types n/a I/O n/a Control Flow Complexity Indicators: Simple Depth: 1 Features: IF Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. IF ( present(config_file) ) THEN Lines 7-10 END IF Line 10 Allocations n/a Variables Type Visibility Attributes Name Initial character(len=*), public :: config_file Source Code subroutine init_input_files ( config_file ) character ( len =* ), intent ( in ), optional :: config_file !< Optional configuration file path ! Default initialization already done in type definition ! This routine could read from config_file to override defaults if ( present ( config_file )) then ! Read overrides from config file (implementation omitted for brevity) ! Example: in_aqu%aqu might be set to \"custom_aquifer.aqu\" end if end subroutine init_input_files","tags":"","url":"proc/init_input_files.html"},{"title":"aqu_read – I/O Trace Example","text":"public  subroutine aqu_read() Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments n/a Uses n/a Outside Variables and Types n/a Local Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: k integer, private :: eof integer, private :: max_aqu logical, private :: file_exists I/O I/O files used in this subroutine. Unit Type Filename Operations unit=107 Unknown in_aqu%aqu → \"aquifer.aqu\" 1 operation(s) Control Flow Complexity Indicators: Simple Depth: 2 Early Exits: 1 Features: ALLOC DO ERROR FILE I/O IF Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. INQUIRE 9 inquire(file=in_aqu%aqu, exist=file_exists) IF ( .not. file_exists ) THEN Lines 10-13 PRINT 11 print *, \"Warning: \", trim(in_aqu%aqu), \" not found\" RETURN 12 return END IF Line 13 OPEN 16 open(unit=107, file=in_aqu%aqu, status='old', action='read') READ 19 read(107, *) READ 22 read(107, *) num_aquifers 25 max_aqu = num_aquifers ALLOCATE 26 allocate(aqudb(max_aqu)) DO i = 1, num_aquifers Lines 29-39 READ 33 read(107, *, iostat=eof) k, aqudb(i) IF ( eof /= 0 ) THEN Lines 35-38 PRINT 36 print *, \"Error reading aquifer data at record\", i EXIT 37 exit END IF Line 38 END DO Line 39 CLOSE 42 close(107) Allocations Memory allocations and deallocations grouped by variable. Variable Allocations Deallocations aqudb line 26 none Source Code subroutine aqu_read integer :: i !< Loop counter for aquifers integer :: k !< Counter/index variable integer :: eof !< End-of-file status indicator integer :: max_aqu !< Maximum number of aquifers to allocate logical :: file_exists !< File existence check flag ! Inquire if file exists before opening inquire ( file = in_aqu % aqu , exist = file_exists ) if (. not . file_exists ) then print * , \"Warning: \" , trim ( in_aqu % aqu ), \" not found\" return end if ! Open aquifer input file on unit 107 open ( unit = 107 , file = in_aqu % aqu , status = 'old' , action = 'read' ) ! Read header line (skip first line with column names) read ( 107 , * ) ! Read number of aquifers from second line read ( 107 , * ) num_aquifers ! Allocate aquifer database array max_aqu = num_aquifers allocate ( aqudb ( max_aqu )) ! Read each aquifer record do i = 1 , num_aquifers ! Read aquifer index and database entry ! Format: k, name, area, hydraulic_cond, specific_yield, alpha, !         initial_storage, min_storage, max_storage read ( 107 , * , iostat = eof ) k , aqudb ( i ) if ( eof /= 0 ) then print * , \"Error reading aquifer data at record\" , i exit end if end do ! Close the file close ( 107 ) end subroutine aqu_read","tags":"","url":"proc/aqu_read.html"},{"title":"output_init – I/O Trace Example","text":"public  subroutine output_init() Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments n/a Uses n/a Outside Variables and Types n/a I/O I/O files used in this subroutine. Unit Type Filename Operations unit=201 Unknown out_files%mgt → mgt.out 1 operation(s) 201 Output unit_201 1 operation(s) unit=202 Unknown out_files%aquifer → aquifer.out 1 operation(s) 202 Output unit_202 1 operation(s) Control Flow Complexity Indicators: Simple Features: FILE I/O Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. OPEN 4 open(unit=201, file=out_files%mgt, status='replace', action='write') WRITE 7 write(201, '(a)') \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" OPEN 10 open(unit=202, file=out_files%aquifer, status='replace', action='write') WRITE 13 write(202, '(a)') \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" Allocations n/a Source Code subroutine output_init ! Open management output file on unit 201 open ( unit = 201 , file = out_files % mgt , status = 'replace' , action = 'write' ) ! Write header for mgt.out write ( 201 , '(a)' ) \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" ! Open aquifer output file on unit 202 open ( unit = 202 , file = out_files % aquifer , status = 'replace' , action = 'write' ) ! Write header for aquifer.out write ( 202 , '(a)' ) \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" end subroutine output_init","tags":"","url":"proc/output_init.html"},{"title":"write_mgt_operation – I/O Trace Example","text":"public  subroutine write_mgt_operation(mgt_op) Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments Type Intent Optional Attributes Name type( mgt_operation_type ), intent(in) :: mgt_op Uses n/a Outside Variables and Types n/a I/O I/O files used in this subroutine. Unit Type Filename Operations 201 Output unit_201 1 operation(s) Control Flow Complexity Indicators: Simple Features: I/O Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. WRITE 5 write(201, '(i5, i5, i8, 2x, a16, f12.3)') & 6 mgt_op%year, mgt_op%day, mgt_op%hru_id, mgt_op%op_type, mgt_op%amount Allocations n/a Variables Type Visibility Attributes Name Initial type( mgt_operation_type ), public :: mgt_op Source Code subroutine write_mgt_operation ( mgt_op ) type ( mgt_operation_type ), intent ( in ) :: mgt_op !< Management operation to write ! Write management operation record write ( 201 , '(i5, i5, i8, 2x, a16, f12.3)' ) & mgt_op % year , mgt_op % day , mgt_op % hru_id , mgt_op % op_type , mgt_op % amount end subroutine write_mgt_operation","tags":"","url":"proc/write_mgt_operation.html"},{"title":"write_aquifer_output – I/O Trace Example","text":"public  subroutine write_aquifer_output(year, day, aqu_id) Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments Type Intent Optional Attributes Name integer, intent(in) :: year integer, intent(in) :: day integer, intent(in) :: aqu_id Uses n/a Outside Variables and Types n/a Local Variables Type Visibility Attributes Name Initial real, private :: storage real, private :: seepage real, private :: revap real, private :: recharge I/O I/O files used in this subroutine. Unit Type Filename Operations 202 Output unit_202 1 operation(s) Control Flow Complexity Indicators: Simple Features: I/O Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. 13 storage = aqudb(aqu_id)%initial_storage 14 seepage = 0.0 15 revap = 0.0 16 recharge = 0.0 WRITE 19 write(202, '(i5, i5, i5, 2x, a16, 4f15.3)') & 20 year, day, aqu_id, aqudb(aqu_id)%name, & 21 storage, seepage, revap, recharge Allocations n/a Variables Type Visibility Attributes Name Initial integer, public :: year integer, public :: day integer, public :: aqu_id Source Code subroutine write_aquifer_output ( year , day , aqu_id ) integer , intent ( in ) :: year !< Simulation year integer , intent ( in ) :: day !< Day of year integer , intent ( in ) :: aqu_id !< Aquifer index real :: storage !< Current storage [m&#94;3] real :: seepage !< Seepage loss [m&#94;3] real :: revap !< Revaporation [m&#94;3] real :: recharge !< Groundwater recharge [m&#94;3] ! These would normally be calculated by the model ! Here we just use placeholder values from the database storage = aqudb ( aqu_id )% initial_storage seepage = 0.0 revap = 0.0 recharge = 0.0 ! Write aquifer output record write ( 202 , '(i5, i5, i5, 2x, a16, 4f15.3)' ) & year , day , aqu_id , aqudb ( aqu_id )% name , & storage , seepage , revap , recharge end subroutine write_aquifer_output","tags":"","url":"proc/write_aquifer_output.html"},{"title":"output_close – I/O Trace Example","text":"public  subroutine output_close() Purpose n/a Stack Flow Called From io_trace_demo Calls n/a Arguments n/a Uses n/a Outside Variables and Types n/a I/O n/a Control Flow Complexity Indicators: Simple Features: FILE I/O Logic Blocks Control flow structures organized as they appear in the source code. \n            Each block is collapsible to help navigate complex procedures. CLOSE 4 close(201) CLOSE 7 close(202) Allocations n/a Source Code subroutine output_close ! Close management output file close ( 201 ) ! Close aquifer output file close ( 202 ) end subroutine output_close","tags":"","url":"proc/output_close.html"},{"title":"object_module – I/O Trace Example","text":"Module for reading object counts\n@author Example Author\n@date 2026-01-22 Uses input_file_module Variables Type Visibility Attributes Name Initial type( object_count_type ), public :: obj_cnt Global object counts Derived Types type, public :: object_count_type Derived type for object counts in the simulation domain Components Type Visibility Attributes Name Initial integer, public :: subbasins = 0 integer, public :: hrus = 0 integer, public :: aquifers = 0 integer, public :: channels = 0 integer, public :: reservoirs = 0 integer, public :: point_sources = 0 Subroutines public  subroutine object_cnt_read () Read object counts from object.cnt file\nThis file defines the size of various spatial objects Arguments None","tags":"","url":"module/object_module.html"},{"title":"input_file_module – I/O Trace Example","text":"Module defining input file names and paths for hydrological model\n@author Example Author\n@date 2026-01-22 Variables Type Visibility Attributes Name Initial type( input_files_type ), public :: in_aqu Global instance of input filenames type( input_files_type ), public :: in_obj Global instance of input filenames Derived Types type, public :: input_files_type Derived type containing all input filenames Components Type Visibility Attributes Name Initial character(len=25), public :: aqu = \"aquifer.aqu\" character(len=25), public :: obj = \"object.cnt\" Subroutines public  subroutine init_input_files (config_file) Initialize input file names from configuration\nThis routine can override default filenames from control file or command line Arguments Type Intent Optional Attributes Name character(len=*), intent(in), optional :: config_file","tags":"","url":"module/input_file_module.html"},{"title":"aquifer_module – I/O Trace Example","text":"Module for reading and managing aquifer data\n@author Example Author\n@date 2026-01-22 Uses aquifer_database input_file_module Subroutines public  subroutine aqu_read () Read aquifer parameters from aquifer.aqu file\nThis subroutine reads hydraulic properties for all aquifers\nFile format: Header lines followed by one record per aquifer\nEach record contains: name, area, K, Sy, alpha, storage_init, storage_min, storage_max Arguments None","tags":"","url":"module/aquifer_module.html"},{"title":"aquifer_database – I/O Trace Example","text":"Module defining aquifer database structures\n@author Example Author\n@date 2026-01-22 Variables Type Visibility Attributes Name Initial type( aquifer_db_type ), public, allocatable :: aqudb (:) Array of all aquifers in the simulation integer, public :: num_aquifers = 0 Number of aquifers Derived Types type, public :: aquifer_db_type Aquifer hydraulic properties and state variables\nThis type stores all parameters for a single aquifer Components Type Visibility Attributes Name Initial character(len=16), public :: name = \"\" real, public :: area = 0.0 real, public :: hydraulic_cond = 0.0 real, public :: specific_yield = 0.0 real, public :: alpha = 0.0 real, public :: initial_storage = 0.0 real, public :: min_storage = 0.0 real, public :: max_storage = 0.0","tags":"","url":"module/aquifer_database.html"},{"title":"output_module – I/O Trace Example","text":"Module for writing model output files\n@author Example Author\n@date 2026-01-22 Uses aquifer_database Variables Type Visibility Attributes Name Initial type( output_files_type ), public :: out_files Global output file names Derived Types type, public :: output_files_type Output file names Components Type Visibility Attributes Name Initial character(len=25), public :: mgt = \"mgt.out\" character(len=25), public :: aquifer = \"aquifer.out\" type, public :: mgt_operation_type Management operation data for output Components Type Visibility Attributes Name Initial integer, public :: year = 0 integer, public :: day = 0 integer, public :: hru_id = 0 character(len=16), public :: op_type = \"\" real, public :: amount = 0.0 Subroutines public  subroutine output_init () Initialize output files and write headers Arguments None public  subroutine write_mgt_operation (mgt_op) Write management operation to mgt.out\n@param mgt_op Management operation data structure Read more… Arguments Type Intent Optional Attributes Name type( mgt_operation_type ), intent(in) :: mgt_op public  subroutine write_aquifer_output (year, day, aqu_id) Write daily aquifer water balance to aquifer.out\n@param year Simulation year\n@param day Day of year\n@param aqu_id Aquifer index Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: year integer, intent(in) :: day integer, intent(in) :: aqu_id public  subroutine output_close () Close all output files Arguments None","tags":"","url":"module/output_module.html"},{"title":"io_trace_demo – I/O Trace Example","text":"Uses output_module object_module input_file_module aquifer_module Main program demonstrating I/O operations\nThis program demonstrates reading from input files and writing to output files\n@author Example Author\n@date 2026-01-22 Variables Type Attributes Name Initial integer :: i type( mgt_operation_type ) :: test_op Source Code program io_trace_demo use input_file_module use aquifer_module use object_module use output_module implicit none integer :: i type ( mgt_operation_type ) :: test_op print * , \"===== I/O Trace Demonstration Program =====\" print * ! Initialize input file names print * , \"Initializing input file names...\" call init_input_files () print * , \"  Aquifer input file: \" , trim ( in_aqu % aqu ) print * , \"  Object count file:  \" , trim ( in_obj % obj ) print * ! Read aquifer data print * , \"Reading aquifer data from \" , trim ( in_aqu % aqu ), \"...\" call aqu_read () print * , \"  Successfully read\" , num_aquifers , \"aquifers\" ! Display aquifer information do i = 1 , num_aquifers print * , \"  Aquifer\" , i , \":\" , trim ( aqudb ( i )% name ) print * , \"    Area:\" , aqudb ( i )% area , \"ha\" print * , \"    Hydraulic conductivity:\" , aqudb ( i )% hydraulic_cond , \"m/day\" print * , \"    Initial storage:\" , aqudb ( i )% initial_storage , \"m&#94;3\" end do print * ! Read object counts print * , \"Reading object counts from \" , trim ( in_obj % obj ), \"...\" call object_cnt_read () print * , \"  Subbasins:\" , obj_cnt % subbasins print * , \"  HRUs:\" , obj_cnt % hrus print * , \"  Aquifers:\" , obj_cnt % aquifers print * , \"  Channels:\" , obj_cnt % channels print * , \"  Reservoirs:\" , obj_cnt % reservoirs print * , \"  Point sources:\" , obj_cnt % point_sources print * ! Initialize output files print * , \"Initializing output files...\" call output_init () print * , \"  Management output: \" , trim ( out_files % mgt ) print * , \"  Aquifer output:    \" , trim ( out_files % aquifer ) print * ! Write sample management operation print * , \"Writing sample management operation...\" test_op % year = 2024 test_op % day = 100 test_op % hru_id = 1 test_op % op_type = \"IRRIGATE\" test_op % amount = 5 0.0 call write_mgt_operation ( test_op ) print * , \"  Written: IRRIGATE operation on day 100\" print * ! Write aquifer output for all aquifers print * , \"Writing aquifer output for day 1...\" do i = 1 , num_aquifers call write_aquifer_output ( 2024 , 1 , i ) end do print * , \"  Written output for\" , num_aquifers , \"aquifers\" print * ! Close output files print * , \"Closing output files...\" call output_close () print * print * , \"===== Demonstration Complete =====\" print * , \"Check mgt.out and aquifer.out for results\" end program io_trace_demo","tags":"","url":"program/io_trace_demo.html"},{"title":"aquifer.aqu – I/O Trace Example ","text":"Procedures Using This File aqu_read (from aquifer_module) I/O Operations Line Operation Raw Statement 30 Open open(unit=107, file=in_aqu%aqu, status='old', action='read')","tags":"","url":"iofile/aquifer_aqu.html"},{"title":"aquifer.out – I/O Trace Example ","text":"Procedures Using This File output_init (from output_module) I/O Operations Line Operation Raw Statement 38 Open open(unit=202, file=out_files%aquifer, status='replace', action='write')","tags":"","url":"iofile/aquifer_out.html"},{"title":"mgt.out – I/O Trace Example ","text":"Procedures Using This File output_init (from output_module) I/O Operations Line Operation Raw Statement 32 Open open(unit=201, file=out_files%mgt, status='replace', action='write')","tags":"","url":"iofile/mgt_out.html"},{"title":"object.cnt – I/O Trace Example ","text":"Procedures Using This File object_cnt_read (from object_module) I/O Operations Line Operation Raw Statement 29 Open open(unit=108, file=in_obj%obj, status='old', action='read', iostat=ios)","tags":"","url":"iofile/object_cnt.html"},{"title":"unit_201 – I/O Trace Example ","text":"Procedures Using This File output_init (from output_module) I/O Operations Line Operation Raw Statement 35 Write write(201, '(a)') \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" Variables Written to This File Module Derived Type Variable Name Data Type Component Name Default Value / Initial unknown NA \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" unknown - - File Schema This section shows the line-by-line schema of the output file, listing each variable/component being written. Line Variable Name Type Component Data Type Initial/Default Value Description 1 \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" - - - - write_mgt_operation (from output_module) I/O Operations Line Operation Raw Statement 53 Write write(201, '(i5, i5, i8, 2x, a16, f12.3)') mgt_op%year, mgt_op%day, mgt_op%hru_id, mgt_op%op_type, mgt_op%amount Variables Written to This File Module Derived Type Variable Name Data Type Component Name Default Value / Initial unknown NA mgt_op unknown year - unknown NA mgt_op unknown day - unknown NA mgt_op unknown hru_id - unknown NA mgt_op unknown op_type - unknown NA mgt_op unknown amount - File Schema This section shows the line-by-line schema of the output file, listing each variable/component being written. Line Variable Name Type Component Data Type Initial/Default Value Description 1 mgt_op%year - - - - 1 mgt_op%day - - - - 1 mgt_op%hru_id - - - - 1 mgt_op%op_type - - - - 1 mgt_op%amount - - - - Sample File Format This section shows the overall format of the output file, which may be written by multiple procedures (e.g., header in one procedure, data in another). Line 3+ (data): \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\", mgt_op%year [written by output_init, write_mgt_operation]\n\n... Note: This format shows how multiple procedures may contribute to the same output file (e.g., one writes the header, another writes the data). When a derived type is written in full, all its components are listed individually.","tags":"","url":"iofile/unit_201.html"},{"title":"unit_202 – I/O Trace Example ","text":"Procedures Using This File output_init (from output_module) I/O Operations Line Operation Raw Statement 41 Write write(202, '(a)') \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" Variables Written to This File Module Derived Type Variable Name Data Type Component Name Default Value / Initial unknown NA \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" unknown - - File Schema This section shows the line-by-line schema of the output file, listing each variable/component being written. Line Variable Name Type Component Data Type Initial/Default Value Description 1 \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" - - - - write_aquifer_output (from output_module) I/O Operations Line Operation Raw Statement 82 Write write(202, '(i5, i5, i5, 2x, a16, 4f15.3)') year, day, aqu_id, aqudb(aqu_id)%name, storage, seepage, revap, recharge Variables Written to This File Module Derived Type Variable Name Data Type Component Name Default Value / Initial unknown NA year unknown - - unknown NA day unknown - - unknown NA aqu_id unknown - - aquifer_database aquifer_db_type aqudb character(len=16) name \"\" Local NA storage real - - Local NA seepage real - - Local NA revap real - - Local NA recharge real - - File Schema This section shows the line-by-line schema of the output file, listing each variable/component being written. Line Variable Name Type Component Data Type Initial/Default Value Description 1 year - - - - 1 day - - - - 1 aqu_id - - - - 1 aqudb%name type(aquifer_db_type) character(len=16) \"\" - 1 storage - - - - 1 seepage - - - - 1 revap - - - - 1 recharge - - - - Sample File Format This section shows the overall format of the output file, which may be written by multiple procedures (e.g., header in one procedure, data in another). Line 3+ (data): \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\", year, day, aqu_id, aqudb(aqu_id)%name, storage, seepage, revap, recharge [written by output_init, write_aquifer_output]\n\n... Note: This format shows how multiple procedures may contribute to the same output file (e.g., one writes the header, another writes the data). When a derived type is written in full, all its components are listed individually.","tags":"","url":"iofile/unit_202.html"},{"title":"io_trace_demo.f90 – I/O Trace Example","text":"Source Code !> Main program demonstrating I/O operations !! This program demonstrates reading from input files and writing to output files !! @author Example Author !! @date 2026-01-22 program io_trace_demo use input_file_module use aquifer_module use object_module use output_module implicit none integer :: i type ( mgt_operation_type ) :: test_op print * , \"===== I/O Trace Demonstration Program =====\" print * ! Initialize input file names print * , \"Initializing input file names...\" call init_input_files () print * , \"  Aquifer input file: \" , trim ( in_aqu % aqu ) print * , \"  Object count file:  \" , trim ( in_obj % obj ) print * ! Read aquifer data print * , \"Reading aquifer data from \" , trim ( in_aqu % aqu ), \"...\" call aqu_read () print * , \"  Successfully read\" , num_aquifers , \"aquifers\" ! Display aquifer information do i = 1 , num_aquifers print * , \"  Aquifer\" , i , \":\" , trim ( aqudb ( i )% name ) print * , \"    Area:\" , aqudb ( i )% area , \"ha\" print * , \"    Hydraulic conductivity:\" , aqudb ( i )% hydraulic_cond , \"m/day\" print * , \"    Initial storage:\" , aqudb ( i )% initial_storage , \"m&#94;3\" end do print * ! Read object counts print * , \"Reading object counts from \" , trim ( in_obj % obj ), \"...\" call object_cnt_read () print * , \"  Subbasins:\" , obj_cnt % subbasins print * , \"  HRUs:\" , obj_cnt % hrus print * , \"  Aquifers:\" , obj_cnt % aquifers print * , \"  Channels:\" , obj_cnt % channels print * , \"  Reservoirs:\" , obj_cnt % reservoirs print * , \"  Point sources:\" , obj_cnt % point_sources print * ! Initialize output files print * , \"Initializing output files...\" call output_init () print * , \"  Management output: \" , trim ( out_files % mgt ) print * , \"  Aquifer output:    \" , trim ( out_files % aquifer ) print * ! Write sample management operation print * , \"Writing sample management operation...\" test_op % year = 2024 test_op % day = 100 test_op % hru_id = 1 test_op % op_type = \"IRRIGATE\" test_op % amount = 5 0.0 call write_mgt_operation ( test_op ) print * , \"  Written: IRRIGATE operation on day 100\" print * ! Write aquifer output for all aquifers print * , \"Writing aquifer output for day 1...\" do i = 1 , num_aquifers call write_aquifer_output ( 2024 , 1 , i ) end do print * , \"  Written output for\" , num_aquifers , \"aquifers\" print * ! Close output files print * , \"Closing output files...\" call output_close () print * print * , \"===== Demonstration Complete =====\" print * , \"Check mgt.out and aquifer.out for results\" end program io_trace_demo","tags":"","url":"sourcefile/io_trace_demo.f90.html"},{"title":"object_module.f90 – I/O Trace Example","text":"Source Code !> Module for reading object counts !! @author Example Author !! @date 2026-01-22 module object_module use input_file_module implicit none !> Derived type for object counts in the simulation domain type :: object_count_type integer :: subbasins = 0 !< Number of subbasins integer :: hrus = 0 !< Number of hydrologic response units integer :: aquifers = 0 !< Number of aquifers integer :: channels = 0 !< Number of stream channels integer :: reservoirs = 0 !< Number of reservoirs integer :: point_sources = 0 !< Number of point source inputs end type object_count_type !> Global object counts type ( object_count_type ) :: obj_cnt contains !> Read object counts from object.cnt file !! This file defines the size of various spatial objects subroutine object_cnt_read integer :: ios !< I/O status code ! Open object count file on unit 108 open ( unit = 108 , file = in_obj % obj , status = 'old' , action = 'read' , iostat = ios ) if ( ios /= 0 ) then print * , \"Error opening\" , trim ( in_obj % obj ) return end if ! Read header read ( 108 , * ) ! Read object counts - each on a separate line with label read ( 108 , * ) obj_cnt % subbasins read ( 108 , * ) obj_cnt % hrus read ( 108 , * ) obj_cnt % aquifers read ( 108 , * ) obj_cnt % channels read ( 108 , * ) obj_cnt % reservoirs read ( 108 , * ) obj_cnt % point_sources ! Close file close ( 108 ) end subroutine object_cnt_read end module object_module","tags":"","url":"sourcefile/object_module.f90.html"},{"title":"input_file_module.f90 – I/O Trace Example","text":"Source Code !> Module defining input file names and paths for hydrological model !! @author Example Author !! @date 2026-01-22 module input_file_module implicit none !> Derived type containing all input filenames type :: input_files_type character ( len = 25 ) :: aqu = \"aquifer.aqu\" !< Aquifer input file (hydraulic properties, initial conditions) character ( len = 25 ) :: obj = \"object.cnt\" !< Object count file (number of spatial objects in simulation) end type input_files_type !> Global instance of input filenames type ( input_files_type ) :: in_aqu , in_obj contains !> Initialize input file names from configuration !! This routine can override default filenames from control file or command line subroutine init_input_files ( config_file ) character ( len =* ), intent ( in ), optional :: config_file !< Optional configuration file path ! Default initialization already done in type definition ! This routine could read from config_file to override defaults if ( present ( config_file )) then ! Read overrides from config file (implementation omitted for brevity) ! Example: in_aqu%aqu might be set to \"custom_aquifer.aqu\" end if end subroutine init_input_files end module input_file_module","tags":"","url":"sourcefile/input_file_module.f90.html"},{"title":"aquifer_module.f90 – I/O Trace Example","text":"Source Code !> Module for reading and managing aquifer data !! @author Example Author !! @date 2026-01-22 module aquifer_module use input_file_module use aquifer_database implicit none contains !> Read aquifer parameters from aquifer.aqu file !! This subroutine reads hydraulic properties for all aquifers !! File format: Header lines followed by one record per aquifer !! Each record contains: name, area, K, Sy, alpha, storage_init, storage_min, storage_max subroutine aqu_read integer :: i !< Loop counter for aquifers integer :: k !< Counter/index variable integer :: eof !< End-of-file status indicator integer :: max_aqu !< Maximum number of aquifers to allocate logical :: file_exists !< File existence check flag ! Inquire if file exists before opening inquire ( file = in_aqu % aqu , exist = file_exists ) if (. not . file_exists ) then print * , \"Warning: \" , trim ( in_aqu % aqu ), \" not found\" return end if ! Open aquifer input file on unit 107 open ( unit = 107 , file = in_aqu % aqu , status = 'old' , action = 'read' ) ! Read header line (skip first line with column names) read ( 107 , * ) ! Read number of aquifers from second line read ( 107 , * ) num_aquifers ! Allocate aquifer database array max_aqu = num_aquifers allocate ( aqudb ( max_aqu )) ! Read each aquifer record do i = 1 , num_aquifers ! Read aquifer index and database entry ! Format: k, name, area, hydraulic_cond, specific_yield, alpha, !         initial_storage, min_storage, max_storage read ( 107 , * , iostat = eof ) k , aqudb ( i ) if ( eof /= 0 ) then print * , \"Error reading aquifer data at record\" , i exit end if end do ! Close the file close ( 107 ) end subroutine aqu_read end module aquifer_module","tags":"","url":"sourcefile/aquifer_module.f90.html"},{"title":"aquifer_database.f90 – I/O Trace Example","text":"Source Code !> Module defining aquifer database structures !! @author Example Author !! @date 2026-01-22 module aquifer_database implicit none !> Aquifer hydraulic properties and state variables !! This type stores all parameters for a single aquifer type :: aquifer_db_type character ( len = 16 ) :: name = \"\" !< Aquifer name/ID real :: area = 0.0 !< Surface area [ha] real :: hydraulic_cond = 0.0 !< Hydraulic conductivity [m/day] real :: specific_yield = 0.0 !< Specific yield (dimensionless, 0-1) real :: alpha = 0.0 !< Baseflow recession coefficient [1/day] real :: initial_storage = 0.0 !< Initial water storage [m&#94;3] real :: min_storage = 0.0 !< Minimum storage threshold [m&#94;3] real :: max_storage = 0.0 !< Maximum storage capacity [m&#94;3] end type aquifer_db_type !> Array of all aquifers in the simulation type ( aquifer_db_type ), allocatable :: aqudb (:) !> Number of aquifers integer :: num_aquifers = 0 end module aquifer_database","tags":"","url":"sourcefile/aquifer_database.f90.html"},{"title":"output_module.f90 – I/O Trace Example","text":"Source Code !> Module for writing model output files !! @author Example Author !! @date 2026-01-22 module output_module use aquifer_database implicit none !> Output file names type :: output_files_type character ( len = 25 ) :: mgt = \"mgt.out\" !< Management operations output character ( len = 25 ) :: aquifer = \"aquifer.out\" !< Aquifer water balance output end type output_files_type !> Global output file names type ( output_files_type ) :: out_files !> Management operation data for output type :: mgt_operation_type integer :: year = 0 !< Simulation year integer :: day = 0 !< Day of year integer :: hru_id = 0 !< HRU identifier character ( len = 16 ) :: op_type = \"\" !< Operation type (e.g., \"PLANT\", \"HARVEST\", \"IRRIGATE\") real :: amount = 0.0 !< Operation amount (units vary by operation) end type mgt_operation_type contains !> Initialize output files and write headers subroutine output_init ! Open management output file on unit 201 open ( unit = 201 , file = out_files % mgt , status = 'replace' , action = 'write' ) ! Write header for mgt.out write ( 201 , '(a)' ) \"YEAR  DAY  HRU_ID  OPERATION  AMOUNT\" ! Open aquifer output file on unit 202 open ( unit = 202 , file = out_files % aquifer , status = 'replace' , action = 'write' ) ! Write header for aquifer.out write ( 202 , '(a)' ) \"YEAR  DAY  AQU_ID  AQU_NAME  STORAGE_M3  SEEPAGE_M3  REVAP_M3  RECHARGE_M3\" end subroutine output_init !> Write management operation to mgt.out !! @param mgt_op Management operation data structure !! @note Unit 201 must be opened via output_init before calling this routine subroutine write_mgt_operation ( mgt_op ) type ( mgt_operation_type ), intent ( in ) :: mgt_op !< Management operation to write ! Write management operation record write ( 201 , '(i5, i5, i8, 2x, a16, f12.3)' ) & mgt_op % year , mgt_op % day , mgt_op % hru_id , mgt_op % op_type , mgt_op % amount end subroutine write_mgt_operation !> Write daily aquifer water balance to aquifer.out !! @param year Simulation year !! @param day Day of year !! @param aqu_id Aquifer index !! @note Unit 202 must be opened via output_init before calling this routine subroutine write_aquifer_output ( year , day , aqu_id ) integer , intent ( in ) :: year !< Simulation year integer , intent ( in ) :: day !< Day of year integer , intent ( in ) :: aqu_id !< Aquifer index real :: storage !< Current storage [m&#94;3] real :: seepage !< Seepage loss [m&#94;3] real :: revap !< Revaporation [m&#94;3] real :: recharge !< Groundwater recharge [m&#94;3] ! These would normally be calculated by the model ! Here we just use placeholder values from the database storage = aqudb ( aqu_id )% initial_storage seepage = 0.0 revap = 0.0 recharge = 0.0 ! Write aquifer output record write ( 202 , '(i5, i5, i5, 2x, a16, 4f15.3)' ) & year , day , aqu_id , aqudb ( aqu_id )% name , & storage , seepage , revap , recharge end subroutine write_aquifer_output !> Close all output files subroutine output_close ! Close management output file close ( 201 ) ! Close aquifer output file close ( 202 ) end subroutine output_close end module output_module","tags":"","url":"sourcefile/output_module.f90.html"}]}